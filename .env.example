# Copy to .env and adjust. Every value below is the development default (server/app/config.py).

# Postgres connection string. docker-compose overrides the host to the `postgres` service.
DATABASE_URL=postgresql://jbi:jbi@localhost:5432/jbi

# Public origin of the client, used to build admin links.
PUBLIC_BASE_URL=http://localhost:5173

# Rooms are deleted this many days after creation.
ROOM_TTL_DAYS=30

# Abuse limits.
ROOMS_PER_IP_PER_HOUR=5
MAX_PLAYERS_PER_ROOM=50

# Directory with shipped question packs, relative to the server working directory.
PACKS_DIR=../data/packs

# debug | info | warning | error
LOG_LEVEL=info
