# Copy to .env and adjust. Every value below is the development default (server/app/config.py).

# Postgres connection string. docker-compose overrides the host to the `postgres` service.
DATABASE_URL=postgresql://jbi:jbi@localhost:5432/jbi

# Public origin players use, used to build admin links.
# `make dev` serves the client on :5173; with docker compose use the app's own
# URL (http://localhost:8000 or your domain).
PUBLIC_BASE_URL=http://localhost:5173

# Rooms are deleted this many days after creation.
ROOM_TTL_DAYS=3

# How often the app deletes rooms that are past ROOM_TTL_DAYS, in seconds. A background
# task in the app does this; there is no cron job to install.
ROOM_CLEANUP_INTERVAL_SECONDS=3600

# Abuse limits. Room creation counts an IPv6 client by its /64.
ROOMS_PER_IP_PER_HOUR=30
MAX_PLAYERS_PER_ROOM=50

# Directory with shipped question packs, relative to the server working directory.
PACKS_DIR=../data/packs

# debug | info | warning | error
LOG_LEVEL=info

# Branding, baked into the client when it is built: `make dev` takes a change on restart,
# docker compose only after `docker compose build`. Unset, the site is The Jolly Boar Inn.
#PUBLIC_SITE_NAME=The Jolly Boar Inn
# An image in branding/ (png, svg, webp, gif, jpg or ico): the top bar's sign, drawn 32px
# square, and the tab icon. A missing file falls back to the bundled sign.
#PUBLIC_SITE_LOGO=branding/logo.png
# The theme for a browser that never picked one: jolly, pollnivneach or wilderness. Anything
# else is jolly.
#PUBLIC_DEFAULT_THEME=jolly

# Tests only, not read by the app: a Postgres server the pytest suite may create and
# drop throwaway databases on. `make test` sets it to the `make dev` database; leave it
# unset to skip the database tests when running pytest directly.
#DATABASE_URL_TEST=postgresql://jbi:jbi@localhost:5432/jbi

# docker compose only: Postgres credentials for the bundled database and the host port.
# The app service ignores DATABASE_URL above and connects to the bundled Postgres.
# POSTGRES_* also applies to the `make dev` database (docker-compose.dev.yml); keep
# them in step with DATABASE_URL above, since the dev server connects over the host.
# POSTGRES_PASSWORD is required by docker-compose.yml and has no default there, so
# that nobody ships the development password to the internet. `make dev` still
# falls back to `jbi`.
POSTGRES_PASSWORD=change-me
#POSTGRES_USER=jbi
#POSTGRES_DB=jbi
#APP_PORT=8000

# docker compose only: which host address the app's port binds to. The default
# assumes a reverse proxy on this machine. Set 0.0.0.0 if the proxy runs elsewhere
# (and firewall the port), or to a specific interface address.
#APP_BIND=127.0.0.1

# docker compose only: reverse proxies whose X-Forwarded-For header is believed,
# as a comma-separated list. Unset, compose passes an empty list, which trusts nothing.
#
# ROOMS_PER_IP_PER_HOUR keys on the client address, so this matters. Traffic through
# a published port arrives from the Docker bridge gateway (commonly 172.17.0.1), not
# from 127.0.0.1 -- so until you set this, every player counts against one shared
# bucket. Set it to your proxy's address as the container sees it; a CIDR range works
# too, and 172.16.0.0/12 covers the default Docker bridge networks. The app logs one
# warning the first time it sees an X-Forwarded-For it ignored, naming the address.
#
# Leave it unset if the port is reachable directly: anyone who can reach it could
# otherwise forge the header and bypass the limit entirely.
#FORWARDED_ALLOW_IPS=172.16.0.0/12

# Fetch scripts only (`make gen-price-questions`), never the app: the User-Agent every request
# to the OSRS Wiki carries. The wiki wants one that "describes what you're using it for", plus
# contact info "like an email or Discord": a project name and how to reach you. The scripts
# refuse to fetch without it, and send at most one request a second.
#WIKI_USER_AGENT=jolly-boar-quiz-importer - yourname on Discord

# `make dev` only: host port for the dev Postgres, bound to 127.0.0.1. Change this
# (and DATABASE_URL above) if you already run Postgres on 5432.
#DEV_POSTGRES_PORT=5432
