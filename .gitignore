# Wiki item icons, the themes' emblems (make fetch-assets): game assets too
client/src/assets/themes/*.png
# The gods' symbols, the teams' logos (make fetch-assets)
client/src/assets/teams/*.png
# Question pictures: staged under their asset ids, copied into the client under random names
.pictures/
client/public/pictures/
data/pictures.json
# The world map's tiles (make gen-map), and where they are built
.map/
client/public/map/

# The price pack: each instance generates its own (make gen-price-questions)
data/packs/prices.json

# The copies `make import-suggestions` and `make edit-packs` run on.
server/.import-suggestions.json
server/.edit-packs.json
server/.edit-roster.json

