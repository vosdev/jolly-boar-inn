          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/Standing"
          },
          "type": "array"
        },
        "server_time": {
          "format": "date-time",
          "type": "string"
        },
        "server_version": {
          "description": "``/VERSION`` of the running server. A client built from another version reloads itself,\nso a deploy never leaves an old bundle reading frames it does not know.",
          "type": "string"
        }
      },
      "required": [
        "t",
        "room",
        "you",
        "players",
        "question",
        "your_answer",
        "standings",
        "server_time",
        "server_version"
      ],
      "title": "Welcome",
      "type": "object"
    }
  }
