{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jollyboarinn.example/schema/question.schema.json",
  "title": "Question",
  "type": "object",
  "required": ["id", "type", "mode", "payload", "source", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^q_[0-9a-f]{16}$" },
    "type": {
      "enum": ["more_less", "price_is_right", "multiple_choice", "free_text",
               "closest_number", "pick_from_list", "pick_all_that_apply",
              "ordering"]
    },
    "mode": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
    "payload": { "type": "object" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "source": { "enum": ["pack", "community", "room"] },
    "tags": {
      "type": "array", "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
    },
    "author": { "type": "string", "maxLength": 64 },
    "added_at": { "type": "string", "format": "date" },
    "host_only": { "type": "boolean", "default": false },
    "random_event": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
    "wiki": {
      "$comment": "Where an author checked the question, for the next author. Never sent to players.",
      "type": "string", "maxLength": 300, "pattern": "^https://oldschool\\.runescape\\.wiki/w/\\S+$"
    },
    "source_url": {
      "$comment": "Where an author checked what the wiki cannot prove, such as a clip. Never sent to players.",
      "type": "string", "maxLength": 300, "pattern": "^https://\\S+$"
    },
    "credit": {
      "$comment": "The player who suggested it, under the name rules of a display name.",
      "type": "string", "minLength": 1, "maxLength": 24
    },
    "credit_shown": {
      "$comment": "Whether a reveal names `credit` to players. Only a pack question's is honoured.",
      "type": "boolean", "default": false
    }
  },
  "dependentRequired": { "credit_shown": ["credit"] },
  "allOf": [
    { "if": { "properties": { "type": { "const": "more_less" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/more_less" } } } },
    { "if": { "properties": { "type": { "const": "price_is_right" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/price_is_right" } } } },
    { "if": { "properties": { "type": { "const": "multiple_choice" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/multiple_choice" } } } },
    { "if": { "properties": { "type": { "const": "free_text" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/free_text" } } } },
    { "if": { "properties": { "type": { "const": "closest_number" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/closest_number" } } } },
    { "if": { "properties": { "type": { "const": "pick_from_list" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/pick_from_list" } } } },
    { "if": { "properties": { "type": { "const": "pick_all_that_apply" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/pick_all_that_apply" } } } },
    { "if": { "properties": { "type": { "const": "ordering" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/ordering" } } } }
  ],
  "$defs": {
    "choices": {
      "$comment": "One gem per answer (design §3). Every array of choices references this and may only narrow it.",
      "type": "array", "minItems": 2, "maxItems": 6
    },
    "asset": { "type": "string", "pattern": "^(item|npc):[0-9]{1,7}$" },
    "short_text": { "type": "string", "minLength": 1, "maxLength": 120 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
    "intro": {
      "$comment": "A random event's NPC, in their own voice, before the plain question in prompt (design §12).",
      "type": "string", "minLength": 1, "maxLength": 150
    },
    "date": { "type": "string", "format": "date" },
    "subject": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/short_text" },
        "asset": { "$ref": "#/$defs/asset" }
      }
    },
    "accepted": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },

    "metric": { "enum": ["ge_price", "high_alch", "shop_price"] },
    "priced": {
      "type": "object", "required": ["subject", "value"], "additionalProperties": false,
      "properties": { "subject": { "$ref": "#/$defs/subject" }, "value": { "type": "integer", "minimum": 0 } }
    },

    "more_less": {
      "type": "object",
      "required": ["metric", "direction", "options", "answer_index", "as_of"],
      "additionalProperties": false,
      "properties": {
        "metric": { "$ref": "#/$defs/metric" },
        "direction": { "enum": ["more", "less"] },
        "options": { "$ref": "#/$defs/choices", "maxItems": 2, "items": { "$ref": "#/$defs/priced" } },
        "answer_index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "as_of": { "$ref": "#/$defs/date" }
      }
    },

    "price_is_right": {
      "type": "object",
      "required": ["subject", "value", "options", "answer_index", "as_of"],
      "additionalProperties": false,
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "value": { "type": "integer", "minimum": 0 },
        "options": {
          "$ref": "#/$defs/choices", "minItems": 4, "maxItems": 4,
          "items": { "type": "integer", "minimum": 0 }
        },
        "answer_index": { "type": "integer", "minimum": 0, "maximum": 3 },
        "as_of": { "$ref": "#/$defs/date" }
      }
    },

    "multiple_choice": {
      "type": "object",
      "required": ["prompt", "options", "answer_index"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "$ref": "#/$defs/prompt" },
        "intro": { "$ref": "#/$defs/intro" },
        "quote": {
          "$comment": "Words someone said, shown as a quotation under the prompt that asks about them.",
          "type": "string", "minLength": 1, "maxLength": 300
        },
        "image": { "$ref": "#/$defs/asset" },
        "options": { "$ref": "#/$defs/choices", "items": { "$ref": "#/$defs/short_text" } },
        "answer_index": { "type": "integer", "minimum": 0, "maximum": 5 },
        "explanation": { "type": "string", "maxLength": 300 }
      }
    },

    "pick_all_that_apply": {
      "type": "object",
      "required": ["prompt", "options", "answer_indices"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "$ref": "#/$defs/prompt" },
        "intro": { "$ref": "#/$defs/intro" },
        "image": { "$ref": "#/$defs/asset" },
        "options": { "$ref": "#/$defs/choices", "minItems": 3, "items": { "$ref": "#/$defs/short_text" } },
        "answer_indices": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 5 }
        },
        "picks": { "type": "integer", "minimum": 1, "maximum": 5 },
        "explanation": { "type": "string", "maxLength": 300 }
      }
    },

    "ordering": {
      "type": "object",
      "required": ["prompt", "ends", "entries", "answer"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "$ref": "#/$defs/prompt" },
        "intro": { "$ref": "#/$defs/intro" },
        "image": { "$ref": "#/$defs/asset" },
        "ends": {
          "$comment": "What the first and the last entry are, such as Weakest and Strongest.",
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "entries": {
          "$ref": "#/$defs/choices", "minItems": 3,
          "items": {
            "type": "object",
            "required": ["text", "rank"],
            "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/short_text" },
              "rank": { "$comment": "Lower comes first; equal ranks tie, and the next rank follows without a gap.", "type": "integer", "minimum": 1, "maximum": 6 },
              "detail": { "$comment": "Shown beside the entry in the reveal.", "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        },
        "answer": {
          "$comment": "Entry indices in the order the reveal shows, sorted by rank.",
          "type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 5 }
        },
        "picks": { "$comment": "Order only this many, from the first end; fewer than the entries.", "type": "integer", "minimum": 2, "maximum": 5 },
        "explanation": { "type": "string", "maxLength": 300 }
      }
    },

    "free_text": {
      "type": "object",
      "required": ["prompt", "accepted"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "$ref": "#/$defs/prompt" },
        "intro": { "$ref": "#/$defs/intro" },
        "image": { "$ref": "#/$defs/asset" },
        "accepted": { "$ref": "#/$defs/accepted" },
        "max_distance": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "explanation": { "type": "string", "maxLength": 300 }
      }
    },

    "closest_number": {
      "type": "object",
      "required": ["prompt", "answer"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "$ref": "#/$defs/prompt" },
        "intro": { "$ref": "#/$defs/intro" },
        "image": { "$ref": "#/$defs/asset" },
        "answer": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 },
        "explanation": { "type": "string", "maxLength": 300 }
      }
    },

    "pick_from_list": {
      "type": "object",
      "required": ["prompt", "vocab", "answer_id"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "$ref": "#/$defs/prompt" },
        "intro": { "$ref": "#/$defs/intro" },
        "vocab": { "enum": ["items", "npcs"] },
        "answer_id": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/$defs/asset" },
        "steps": { "type": "integer", "minimum": 1, "maximum": 12 },
        "subject": { "$ref": "#/$defs/subject" },
        "explanation": { "type": "string", "maxLength": 300 }
      }
    }
  }
}
